#!/usr/bin/env ruby
# Continuous scan across every ratchet family, logging every cycle -- including
# empty ones, because the funding gate needs a RATE and that needs a denominator.
#
#   doppler run --only-secrets KALSHI_KEY_ID,KALSHI_KEY -p ericdahl-dev -c prd -- \
#     bin/collect_opportunities
#
# Read-only against the venue. The execution pipeline below is DRY-RUN: it
# writes intents to orders.jsonl and its transport raises if anything ever
# tries to reach the network. Gate item #3 is scored off that file.

require_relative "../lib/opportunity_collector"
require_relative "../lib/execution/pipeline"
require_relative "../lib/kalshi_client"

data_dir = ENV["DATA_DIR"] || File.expand_path("../data/opportunities", __dir__)

OpportunityCollector.new(
  data_dir: data_dir,
  interval: Integer(ENV.fetch("INTERVAL", "60")),
  # The reader is GET-only market data for exit-on-repricing quote checks;
  # the order path stays dry-run with a transport that refuses the network.
  execution: Execution::Pipeline.build(data_dir: data_dir, reader: KalshiClient.new)
).run(seconds: ENV["SECONDS"] && Integer(ENV["SECONDS"]))
