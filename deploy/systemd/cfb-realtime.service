[Unit]
Description=Coinbase Futures Bot - realtime WS + trading loop (paper)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Without this the loop boots in development, Rails.logger writes to
# log/development.log, and journald sees only `puts` and crash backtraces —
# seven days of the journal contained zero logger lines while a swallowed Order
# failure repeated in the file nobody was tailing.
Environment=RAILS_LOG_TO_STDOUT=1
WorkingDirectory=%h/coinbase_futures_bot
ExecStart=/bin/bash -lc "cd %h/coinbase_futures_bot && exec env INLINE=1 bundle exec rails real_time:start"
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
